#LOCAL REAL X
#LOCAL REAL ENV
#LOCAL REAL W
#LOCAL REAL AMPA
#LOCAL REAL AMPB
#LOCAL REAL AMPC
#LOCAL REAL PLSA
#LOCAL REAL PLSB
#LOCAL REAL PLSC
#LOCAL REAL GA
#LOCAL REAL GB
#LOCAL REAL GC
#LOCAL REAL VPKA
#LOCAL REAL VPKB
#LOCAL REAL VPKC
#LOCAL REAL PHA
#LOCAL REAL PHB
#LOCAL REAL PHC
      TS = $Clock
      W = 3.7699111843077515D+02
      VPKA = 6.2461988440971053D+05
      PHA = 0.0000000000000000D+00
      PLSA = 0.0D0
      GA = 0.0D0
      VPKB = 6.2461988440971053D+05
      PHB = -2.0943951023931953D+00
      PLSB = 0.0D0
      GB = 0.0D0
      VPKC = 6.2461988440971053D+05
      PHC = 2.0943951023931953D+00
      PLSC = 0.0D0
      GC = 0.0D0
      X = (TS + 1.0000000000000000D+00)/5.0D-2
      IF (X .LT. 0.0D0) X = 0.0D0
      IF (X .GT. 1.0D0) X = 1.0D0
      ENV = X*X*X*(1.0D1 + X*(-1.5D1 + 6.0D0*X))
      AMPA = ENV
      AMPB = ENV
      AMPC = ENV
      X = (TS - 2.0000000000000000D-02)/5.0000000000000002D-05
      IF (X .LT. 0.0D0) X = 0.0D0
      IF (X .GT. 1.0D0) X = 1.0D0
      ENV = X*X*X*(1.0D1 + X*(-1.5D1 + 6.0D0*X))
      X = (TS - 5.9999999999999998D-02)/2.0000000000000000D-03
      IF (X .LT. 0.0D0) X = 0.0D0
      IF (X .GT. 1.0D0) X = 1.0D0
      ENV = ENV - X*X*X*(1.0D1 + X*(-1.5D1 + 6.0D0*X))
      GA = GA + 1.9092639084899016D-01*ENV
      GB = GB + 1.9092639084899016D-01*ENV
      GC = GC + 1.9092639084899016D-01*ENV
      $Ea = PLSA + AMPA*VPKA*COS(W*TS + PHA)
      $Ea = $Ea*1.0D-3
      $Ra = 1.0D0/MAX(GA, 1.0D-9)
      $Eb = PLSB + AMPB*VPKB*COS(W*TS + PHB)
      $Eb = $Eb*1.0D-3
      $Rb = 1.0D0/MAX(GB, 1.0D-9)
      $Ec = PLSC + AMPC*VPKC*COS(W*TS + PHC)
      $Ec = $Ec*1.0D-3
      $Rc = 1.0D0/MAX(GC, 1.0D-9)
]]></segment></script></Definition><Definition classid="UserCmpDefn" name="MainArt" group="" build="" id="996075316" view="false" instance="0" crc="0"><paramlist><param name="Description" value=""/></paramlist><form name="MainArt" w="540" h="400" splitter="60"/><graphics><Gfx classid="Graphics.Rectangle" id="351549097" x="0" y="0" w="4896" h="6336"><paramlist><param name="color" value="#fffbfcfa"/><param name="thickness" value="0"/><param name="fill_style" value="1"/><param name="fill_fg" value="#fffbfcfa"/></paramlist></Gfx><Gfx classid="Graphics.Rectangle" id="345124458" x="0" y="0" w="4896" h="126"><paramlist><param name="color" value="#ffedf1f3"/><param name="thickness" value="0"/><param name="fill_style" value="1"/><param name="fill_fg" value="#ffedf1f3"/></paramlist></Gfx><Gfx classid="Graphics.Text" id="244782711" x="144" y="270"><paramlist><param name="text" value="765 kV 765kv-horizontal: Frequency-dependent line, fault"/><param name="color" value="#ff193544"/><param name="full_font" value="Tahoma, 64world"/><param name="font_size" value="0"/><param name="anchor" value="0"/><param name="angle" value="0"/></paramlist></Gfx></graphics></Definition><Definition classid="RowDefn" name="l765_fd" group="" build="" id="208060648" view="false" instance="0" crc="0"><paramlist><param name="Description" value=""/><param name="type" value="TLine"/></paramlist><schematic classid="RowCanvas" zoomlevel="6" scrollx="0" scrolly="0"><paramlist><param name="show_grid" value="1"/><param name="size" value="0"/><param name="orient" value="1"/><param name="show_border" value="0"/></paramlist><grouping/><User classid="UserCmp" id="737306885" x="594" y="180" w="18" h="18" z="-1" orient="0" defn="master:Line_FrePhase_Options" link="-1" q="4" disable="false"><paramlist name="" link="-1" crc="0"><param name="Interp1" value="1"/><param name="Output" value="1"/><param name="Inflen" value="0"/><param name="FS" value="0.01 [Hz]"/><param name="FE" value="1000000.0 [Hz]"/><param name="Numf" 