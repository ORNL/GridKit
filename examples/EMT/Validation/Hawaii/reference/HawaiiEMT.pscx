  <Definition classid="UserCmpDefn" name="PMU1" group="" build="" id="100005879" view="false" instance="0" crc="0">
   <paramlist>
    <param name="Description" value="1_pmu" />
   </paramlist>
   <form name="1_pmu" w="400" h="400" splitter="60" />
   <script><segment name="Dsdyn" id="1800000009" classid="CoreSegment">#STORAGE REAL:3
#LOCAL REAL gktheta
#LOCAL REAL gkpllxi
#LOCAL REAL gkms
#LOCAL REAL gka
#LOCAL REAL gkb
#LOCAL REAL gkc
#LOCAL REAL gkvq
#LOCAL REAL gkw
      IF (TIMEZERO) THEN
      STORF(NSTORF + 0) = -1.953834750431190d-02
      STORF(NSTORF + 1) = 0.000000000000000d+00
      STORF(NSTORF + 2) = 1.879801754478560d+04
      ENDIF
      gktheta = STORF(NSTORF + 0)
      gkpllxi = STORF(NSTORF + 1)
      gkms = STORF(NSTORF + 2)
      gka = $Va - ($Va + $Vb + $Vc) / 3d0
      gkb = $Vb - ($Va + $Vb + $Vc) / 3d0
      gkc = $Vc - ($Va + $Vb + $Vc) / 3d0
      gkvq = 1000d0 * ((gkb - gkc) / sqrt(3d0) * cos(gktheta) - gka *
     +  sin(gktheta))
      gkw = 3.769911184307751d+02 + 7.099970268936500d-04 * gkvq +
     +  gkpllxi
      $Vrms = 1000d0 * sqrt(max(0d0, gkms))
      IF (.NOT. TIMEZERO) THEN
      STORF(NSTORF + 0) = gktheta + DELT * (gkw)
      STORF(NSTORF + 1) = gkpllxi + DELT * (2.218740709042800d-02 *
     +  gkvq)
      STORF(NSTORF + 2) = gkms + DELT * (120d0 * (gka**2 + gkb**2 +
     +  gkc**2 - gkms))
      ENDIF
      NSTORF = NSTORF + 3</segment></script><graphics>
