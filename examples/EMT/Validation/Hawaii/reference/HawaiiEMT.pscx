   </paramlist>
   <form name="Analog PMU, REPCA, REECB and REGCA" w="400" h="400" splitter="60" />
   <script><segment name="Dsdyn" id="1800000001" classid="CoreSegment">#STORAGE REAL:14
#LOCAL REAL gktheta
#LOCAL REAL gkpllxi
#LOCAL REAL gkms
#LOCAL REAL gkip
#LOCAL REAL gkiq
#LOCAL REAL gkil
#LOCAL REAL gkpmup
#LOCAL REAL gkpmuq
#LOCAL REAL gkrepv
#LOCAL REAL gkxq
#LOCAL REAL gkql
#LOCAL REAL gkreev
#LOCAL REAL gkqv
#LOCAL REAL gkpord
#LOCAL REAL gka
#LOCAL REAL gkb
#LOCAL REAL gkc
#LOCAL REAL gkvq
#LOCAL REAL gkw
#LOCAL REAL gkenable
#LOCAL REAL gkvt
#LOCAL REAL gkia
#LOCAL REAL gkib
#LOCAL REAL gkic
#LOCAL REAL gkerr
#LOCAL REAL gkqpi
#LOCAL REAL gkgate
#LOCAL REAL gksafe
#LOCAL REAL gkprate
#LOCAL REAL gkprlim
#LOCAL REAL gkqdyn
#LOCAL REAL gkiqcmd
#LOCAL REAL gkcircle
#LOCAL REAL gkhinge
#LOCAL REAL gkimax
#LOCAL REAL gkipcmd
#LOCAL REAL gktarget
#LOCAL REAL gkavail
#LOCAL REAL gkfloor
#LOCAL REAL gkabsorbed
      IF (TIMEZERO) THEN
      STORF(NSTORF + 0) = -3.675690300224190d-02
      STORF(NSTORF + 1) = 0.000000000000000d+00
      STORF(NSTORF + 2) = 4.761000000000020d+03
      STORF(NSTORF + 3) = 7.735685438157029d-01
      STORF(NSTORF + 4) = 3.259386632291480d-03
      STORF(NSTORF + 5) = 1.220000028609700d+00
      STORF(NSTORF + 6) = 1.253181100000000d+01
      STORF(NSTORF + 7) = 5.280206592983520d-02
      STORF(NSTORF + 8) = 1.000000000000000d+00
      STORF(NSTORF + 9) = 3.259386632294030d-03
      STORF(NSTORF + 10) = 3.259386632294030d-03
      STORF(NSTORF + 11) = 1.000000000000000d+00
      STORF(NSTORF + 12) = 3.259386632294030d-03
      STORF(NSTORF + 13) = 7.735685438156800d-01
      ENDIF
      gktheta = STORF(NSTORF + 0)
      gkpllxi = STORF(NSTORF + 1)
      gkms = STORF(NSTORF + 2)
      gkip = STORF(NSTORF + 3)
      gkiq = STORF(NSTORF + 4)
      gkil = STORF(NSTORF + 5)
      gkpmup = STORF(NSTORF + 6)
      gkpmuq = STORF(NSTORF + 7)
      gkrepv = STORF(NSTORF + 8)
      gkxq = STORF(NSTORF + 9)
      gkql = STORF(NSTORF + 10)
      gkreev = STORF(NSTORF + 11)
      gkqv = STORF(NSTORF + 12)
      gkpord = STORF(NSTORF + 13)
      gka = $Va - ($Va + $Vb + $Vc) / 3d0
      gkb = $Vb - ($Va + $Vb + $Vc) / 3d0
      gkc = $Vc - ($Va + $Vb + $Vc) / 3d0
      gkvq = 1000d0 * ((gkb - gkc) / sqrt(3d0) * cos(gktheta) - gka *
     +  sin(gktheta))
      gkw = 3.769911184307751d+02 + 1.419994053787300d-03 * gkvq +
     +  gkpllxi
      gkenable = merge(1d0, 0d0, TIME .GE. 1.0d0)
      gkvt = sqrt(max(0d0, gkms)) / 6.900000000000000d+01
      gkia = 1.916992062893659d-01 * (gkip * cos((gktheta +
     +  (0.000000000000000d+00))) + gkiq * sin((gktheta +
     +  (0.000000000000000d+00))))
      gkib = 1.916992062893659d-01 * (gkip * cos((gktheta +
     +  (-2.094395102393195d+00))) + gkiq * sin((gktheta +
     +  (-2.094395102393195d+00))))
      gkic = 1.916992062893659d-01 * (gkip * cos((gktheta +
     +  (2.094395102393195d+00))) + gkiq * sin((gktheta +
     +  (2.094395102393195d+00))))
      gkerr = ((-1.000000000000000d+00) + (max(0d0,
     +  ((1.000000000000000d+00 - gkrepv) - (-1.000000000000000d+00))) +
     +  log(1d0 + exp(-240d0 * abs((1.000000000000000d+00 - gkrepv) -
     +  (-1.000000000000000d+00)))) / 240d0) - (max(0d0,
     +  ((1.000000000000000d+00 - gkrepv) - (1.000000000000000d+00))) +
     +  log(1d0 + exp(-240d0 * abs((1.000000000000000d+00 - gkrepv) -
     +  (1.000000000000000d+00)))) / 240d0))
      gkqpi = ((-1.000000000000000d+00) + (max(0d0,
     +  ((3.410000085830700d+00 * gkerr + gkxq) -
     +  (-1.000000000000000d+00))) + log(1d0 + exp(-240d0 *
     +  abs((3.410000085830700d+00 * gkerr + gkxq) -
     +  (-1.000000000000000d+00)))) / 240d0) - (max(0d0,
     +  ((3.410000085830700d+00 * gkerr + gkxq) -
     +  (1.000000000000000d+00))) + log(1d0 + exp(-240d0 *
     +  abs((3.410000085830700d+00 * gkerr + gkxq) -
     +  (1.000000000000000d+00)))) / 240d0))
      gkgate = (0.5d0 + 0.5d0 * tanh(120d0 * (gkvt -
     +  8.500000238418600d-01))) + (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (1.149999976158100d+00 - gkvt))) - 1d0
      gksafe = 0.01d0 + (max(0d0, (gkreev - 0.01d0)) + log(1d0 +
     +  exp(-240d0 * abs(gkreev - 0.01d0))) / 240d0)
      gkprate = (7.735685438157032d-01 - gkpord) /
     +  3.900000080466300d-02
      gkprlim = gkprate / (1d0 + (max(0d0, (gkprate /
     +  9.900000000000000d+01 - 1d0)) + log(1d0 + exp(-240d0 *
     +  abs(gkprate / 9.900000000000000d+01 - 1d0))) / 240d0) + (max(0d0,
     +  (gkprate / (-9.900000000000000d+01) - 1d0)) + log(1d0 +
     +  exp(-240d0 * abs(gkprate / (-9.900000000000000d+01) - 1d0))) /
     +  240d0))
      gkqdyn = ((-1.100000023841900d+00) + (max(0d0,
     +  ((5.000000000000000d+00 * (1.000000000000000d+00 - gkreev)) -
     +  (-1.100000023841900d+00))) + log(1d0 + exp(-240d0 *
     +  abs((5.000000000000000d+00 * (1.000000000000000d+00 - gkreev)) -
     +  (-1.100000023841900d+00)))) / 240d0) - (max(0d0,
     +  ((5.000000000000000d+00 * (1.000000000000000d+00 - gkreev)) -
     +  (1.100000023841900d+00))) + log(1d0 + exp(-240d0 *
     +  abs((5.000000000000000d+00 * (1.000000000000000d+00 - gkreev)) -
     +  (1.100000023841900d+00)))) / 240d0))
      gkiqcmd = ((-1.299999952316300d+00) + (max(0d0, ((gkqv + gkqdyn)
     +  - (-1.299999952316300d+00))) + log(1d0 + exp(-240d0 * abs((gkqv +
     +  gkqdyn) - (-1.299999952316300d+00)))) / 240d0) - (max(0d0, ((gkqv
     +  + gkqdyn) - (1.299999952316300d+00))) + log(1d0 + exp(-240d0 *
     +  abs((gkqv + gkqdyn) - (1.299999952316300d+00)))) / 240d0))
      gkcircle = (1.299999952316300d+00 - gkiqcmd) *
     +  (1.299999952316300d+00 + gkiqcmd)
      gkhinge = 0.5d0 * (gkcircle + hypot(gkcircle,
     +  9.251858538542972d-17))
      gkimax = gkhinge / sqrt(gkhinge + 1.736111111111111d-05)
      gkipcmd = ((0d0) + (max(0d0, ((gkpord / gksafe) - (0d0))) +
     +  log(1d0 + exp(-240d0 * abs((gkpord / gksafe) - (0d0)))) / 240d0)
     +  - (max(0d0, ((gkpord / gksafe) - (gkimax))) + log(1d0 +
     +  exp(-240d0 * abs((gkpord / gksafe) - (gkimax)))) / 240d0))
      gktarget = 3.050000253319697d+00 * ((max(0d0, (gkvt -
     +  5.000000000000000d-01)) + log(1d0 + exp(-240d0 * abs(gkvt -
     +  5.000000000000000d-01))) / 240d0) - (max(0d0, (gkvt -
     +  8.999999761581400d-01)) + log(1d0 + exp(-240d0 * abs(gkvt -
     +  8.999999761581400d-01))) / 240d0))
      gkavail = gkil * 2.499999962747063d+00 * ((max(0d0, (gkvt -
     +  4.000000059604600d-01)) + log(1d0 + exp(-240d0 * abs(gkvt -
     +  4.000000059604600d-01))) / 240d0) - (max(0d0, (gkvt -
     +  8.000000119209300d-01)) + log(1d0 + exp(-240d0 * abs(gkvt -
     +  8.000000119209300d-01))) / 240d0))
      gkfloor = min(gkiqcmd, -1.299999952316300d+00)
      gkabsorbed = 6.999999880790700d-01 * (max(0d0, (gkvt -
     +  1.200000047683700d+00)) + log(1d0 + exp(-240d0 * abs(gkvt -
     +  1.200000047683700d+00))) / 240d0)
      $Vrms = 1000d0 * sqrt(max(0d0, gkms))
      $IA = gkia
      $CommandA = 1.916992062893659d-01 * (gkip * cos(((gktheta +
     +  (0.000000000000000d+00)) + DELT * gkw)) + gkiq * sin(((gktheta +
     +  (0.000000000000000d+00)) + DELT * gkw)))
      $IB = gkib
      $CommandB = 1.916992062893659d-01 * (gkip * cos(((gktheta +
     +  (-2.094395102393195d+00)) + DELT * gkw)) + gkiq * sin(((gktheta +
     +  (-2.094395102393195d+00)) + DELT * gkw)))
      $IC = gkic
      $CommandC = 1.916992062893659d-01 * (gkip * cos(((gktheta +
     +  (2.094395102393195d+00)) + DELT * gkw)) + gkiq * sin(((gktheta +
     +  (2.094395102393195d+00)) + DELT * gkw)))
      $Qext = gkql * 1.620000076293900d-01
      $Iqcmd = gkiqcmd
      $Ipcmd = gkipcmd
      IF (.NOT. TIMEZERO) THEN
      STORF(NSTORF + 0) = gktheta + DELT * (gkw)
      STORF(NSTORF + 1) = gkpllxi + DELT * (4.437481418085500d-02 *
     +  gkvq)
      STORF(NSTORF + 2) = gkms + DELT * (120d0 * (gka**2 + gkb**2 +
     +  gkc**2 - gkms))
      STORF(NSTORF + 6) = gkpmup + DELT * (120d0 * (gka * gkia + gkb *
     +  gkib + gkc * gkic - gkpmup))
      STORF(NSTORF + 7) = gkpmuq + DELT * (120d0 * (((gkb - gkc) * gkia
     +  + (gkc - gka) * gkib + (gka - gkb) * gkic) / sqrt(3d0) - gkpmuq))
      STORF(NSTORF + 8) = gkrepv + DELT * (gkenable * (gkvt - gkrepv) /
     +  1.000000000000000d-03)
      STORF(NSTORF + 9) = gkxq + DELT * (gkenable * (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkvt - 6.999999880790700d-01))) *
     +  1.228738988785036d+00 * (gkqpi - ((-1.000000000000000d+00) +
     +  (max(0d0, ((gkxq) - (-1.000000000000000d+00))) + log(1d0 +
     +  exp(-240d0 * abs((gkxq) - (-1.000000000000000d+00)))) / 240d0) -
     +  (max(0d0, ((gkxq) - (1.000000000000000d+00))) + log(1d0 +
     +  exp(-240d0 * abs((gkxq) - (1.000000000000000d+00)))) / 240d0))))
      STORF(NSTORF + 10) = gkql + DELT * (gkenable * (gkqpi - gkql) /
     +  2.150000095367400d+00)
      STORF(NSTORF + 11) = gkreev + DELT * (gkenable * (gkvt - gkreev)
     +  / 1.999999955296500d-02)
      STORF(NSTORF + 12) = gkqv + DELT * (gkenable * gkgate * (gkql /
     +  gksafe - gkqv) / 1.999999955296500d-02)
      STORF(NSTORF + 13) = gkpord + DELT * (gkenable * gkgate * ((0.5d0
     +  + 0.5d0 * tanh(120d0 * (gkpord - (0.000000000000000d+00)))) *
     +  (0.5d0 + 0.5d0 * tanh(120d0 * ((1.000000000000000d+00) -
     +  gkpord))) + (1d0 - (0.5d0 + 0.5d0 * tanh(120d0 *
     +  ((1.000000000000000d+00) - gkpord)))) * (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (-gkprlim))) + (1d0 - (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (gkpord - (0.000000000000000d+00))))) * (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkprlim)))) * gkprlim)
      STORF(NSTORF + 5) = gkil + DELT * (gkenable * min((gktarget -
     +  gkil) / 1.999999955296500d-02, 1.000000000000000d+01))
      STORF(NSTORF + 3) = gkip + DELT * (gkenable * (min(gkipcmd,
     +  gkavail) - gkip) / 1.989999972283800d-02)
      STORF(NSTORF + 4) = gkiq + DELT * (gkenable * (gkfloor + max(0d0,
     +  gkiqcmd - gkfloor - gkabsorbed) - gkiq) / 1.989999972283800d-02)
      ENDIF
      NSTORF = NSTORF + 14</segment></script><graphics>
    <Gfx classid="Graphics.Rectangle" id="100005544" x="-108" y="-18" w="216" h="522">
