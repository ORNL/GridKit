  <Definition classid="UserCmpDefn" name="Plant28_1" group="" build="" id="100005753" view="false" instance="0" crc="0">
   <paramlist>
    <param name="Description" value="Analog PMU, REPCA, REECB and REGCA" />
   </paramlist>
   <form name="Analog PMU, REPCA, REECB and REGCA" w="400" h="400" splitter="60" />
   <script><segment name="Dsdyn" id="1800000006" classid="CoreSegment">#STORAGE REAL:14
#LOCAL REAL gktheta
#LOCAL REAL gkpllxi
#LOCAL REAL gkms
#LOCAL REAL gkip
#LOCAL REAL gkiq
#LOCAL REAL gkil
#LOCAL REAL gkpmup
#LOCAL REAL gkpmuq
#LOCAL REAL gkrepv
#LOCAL REAL gkxq
#LOCAL REAL gkql
#LOCAL REAL gkreev
#LOCAL REAL gkqv
#LOCAL REAL gkpord
#LOCAL REAL gka
#LOCAL REAL gkb
#LOCAL REAL gkc
#LOCAL REAL gkvq
#LOCAL REAL gkw
#LOCAL REAL gkenable
#LOCAL REAL gkvt
#LOCAL REAL gkia
#LOCAL REAL gkib
#LOCAL REAL gkic
#LOCAL REAL gkerr
#LOCAL REAL gkqpi
#LOCAL REAL gkgate
#LOCAL REAL gksafe
#LOCAL REAL gkprate
#LOCAL REAL gkprlim
#LOCAL REAL gkqdyn
#LOCAL REAL gkiqcmd
#LOCAL REAL gkcircle
#LOCAL REAL gkhinge
#LOCAL REAL gkimax
#LOCAL REAL gkipcmd
#LOCAL REAL gktarget
#LOCAL REAL gkavail
#LOCAL REAL gkfloor
#LOCAL REAL gkabsorbed
      IF (TIMEZERO) THEN
      STORF(NSTORF + 0) = 4.085655844556040d-03
      STORF(NSTORF + 1) = 0.000000000000000d+00
      STORF(NSTORF + 2) = 4.761000000000000d+03
      STORF(NSTORF + 3) = 8.589978983167560d-01
      STORF(NSTORF + 4) = -1.017949760013580d-01
      STORF(NSTORF + 5) = 1.220000028609700d+00
      STORF(NSTORF + 6) = 4.629998803000000d+01
      STORF(NSTORF + 7) = -5.486749361800010d+00
      STORF(NSTORF + 8) = 1.000000000000000d+00
      STORF(NSTORF + 9) = -1.017949760013580d-01
      STORF(NSTORF + 10) = -1.017949760013580d-01
      STORF(NSTORF + 11) = 1.000000000000000d+00
      STORF(NSTORF + 12) = -1.017949760013580d-01
      STORF(NSTORF + 13) = 8.589978983167600d-01
      ENDIF
      gktheta = STORF(NSTORF + 0)
      gkpllxi = STORF(NSTORF + 1)
      gkms = STORF(NSTORF + 2)
      gkip = STORF(NSTORF + 3)
      gkiq = STORF(NSTORF + 4)
      gkil = STORF(NSTORF + 5)
      gkpmup = STORF(NSTORF + 6)
      gkpmuq = STORF(NSTORF + 7)
      gkrepv = STORF(NSTORF + 8)
      gkxq = STORF(NSTORF + 9)
      gkql = STORF(NSTORF + 10)
      gkreev = STORF(NSTORF + 11)
      gkqv = STORF(NSTORF + 12)
      gkpord = STORF(NSTORF + 13)
      gka = $Va - ($Va + $Vb + $Vc) / 3d0
      gkb = $Vb - ($Va + $Vb + $Vc) / 3d0
      gkc = $Vc - ($Va + $Vb + $Vc) / 3d0
      gkvq = 1000d0 * ((gkb - gkc) / sqrt(3d0) * cos(gktheta) - gka *
     +  sin(gktheta))
      gkw = 3.769911184307751d+02 + 1.419994053787300d-03 * gkvq +
