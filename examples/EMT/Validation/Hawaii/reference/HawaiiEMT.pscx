     +  0.57d0)
      gktsample = merge(1d0, 0d0, TIME .GT. 0.88d0 .AND. TIME .LE.
     +  0.98d0)
      gkenable = merge(1d0, 0d0, TIME .GE. 1.0d0)
      gksp = merge($Speed, 1d0, TIME .GE. 1.0d0)
      gkdw = gksp - 1d0
      gkvraw = -gkvalve + (3.265761078326100d-02 - gkdw) /
     +  5.000000074505800d-02
      gkvalverate = (((0.5d0 + 0.5d0 * tanh(120d0 * (gkvalve -
     +  (0.000000000000000d+00)))) * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  ((1.000000000000000d+00) - gkvalve))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * ((1.000000000000000d+00) - gkvalve)))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * (-gkvraw))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkvalve - (0.000000000000000d+00))))) * (0.5d0 +
