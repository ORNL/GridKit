   <script><segment name="Dsdyn" id="1800000036" classid="CoreSegment">#STORAGE REAL:11
#LOCAL REAL gkfieldstart
#LOCAL REAL gktorquestart
#LOCAL REAL gkvalve
#LOCAL REAL gkpt
#LOCAL REAL gkx1
#LOCAL REAL gkx3
#LOCAL REAL gkwash
#LOCAL REAL gkvts
#LOCAL REAL gkreg
#LOCAL REAL gkef
#LOCAL REAL gkfx
#LOCAL REAL gksample
#LOCAL REAL gktsample
#LOCAL REAL gkenable
#LOCAL REAL gksp
#LOCAL REAL gkdw
#LOCAL REAL gkvraw
#LOCAL REAL gkvalverate
#LOCAL REAL gkpm
#LOCAL REAL gklead1
#LOCAL REAL gklead3
#LOCAL REAL gkvs
#LOCAL REAL gkvf
#LOCAL REAL gkrraw
#LOCAL REAL gkgap
      IF (TIMEZERO) THEN
      STORF(NSTORF + 0) = 0.000000000000000d+00
      STORF(NSTORF + 1) = 0.000000000000000d+00
      STORF(NSTORF + 2) = 9.090909227272700d-01
      STORF(NSTORF + 3) = 9.090909227272700d-01
      STORF(NSTORF + 4) = 1.000000000000000d+00
      STORF(NSTORF + 5) = 1.000000000000000d+00
      STORF(NSTORF + 6) = 1.000000000000000d+00
      STORF(NSTORF + 7) = 1.000000000000000d+00
      STORF(NSTORF + 8) = -1.224449864213310d-01
      STORF(NSTORF + 9) = 2.040749819303170d+00
      STORF(NSTORF + 10) = 1.257996481073270d-01
      ENDIF
      gkfieldstart = STORF(NSTORF + 0)
      gktorquestart = STORF(NSTORF + 1)
      gkvalve = STORF(NSTORF + 2)
      gkpt = STORF(NSTORF + 3)
      gkx1 = STORF(NSTORF + 4)
      gkx3 = STORF(NSTORF + 5)
      gkwash = STORF(NSTORF + 6)
      gkvts = STORF(NSTORF + 7)
      gkreg = STORF(NSTORF + 8)
      gkef = STORF(NSTORF + 9)
      gkfx = STORF(NSTORF + 10)
      gksample = merge(1d0, 0d0, TIME .GT. 0.47d0 .AND. TIME .LE.
     +  0.57d0)
      gktsample = merge(1d0, 0d0, TIME .GT. 0.88d0 .AND. TIME .LE.
     +  0.98d0)
      gkenable = merge(1d0, 0d0, TIME .GE. 1.0d0)
      gksp = merge($Speed, 1d0, TIME .GE. 1.0d0)
      gkdw = gksp - 1d0
      gkvraw = -gkvalve + (4.545454681368900d-02 - gkdw) /
     +  5.000000074505800d-02
      gkvalverate = (((0.5d0 + 0.5d0 * tanh(120d0 * (gkvalve -
     +  (0.000000000000000d+00)))) * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  ((1.000000000000000d+00) - gkvalve))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * ((1.000000000000000d+00) - gkvalve)))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * (-gkvraw))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkvalve - (0.000000000000000d+00))))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * (gkvraw)))) * gkvraw) /
     +  5.000000000000000d-01
      gkpm = (gkpt - 0.000000000000000d+00 * gkdw) *
     +  1.000000000000000d+00
      gklead1 = gkx1 + 1.666666703919584d+01 * (gksp - gkx1)
      gklead3 = gkx3 + 6.999999880790800d-01 * (gklead1 - gkx3)
      gkvs = ((-1.000000014901200d-01) + (max(0d0,
     +  ((1.000000014901200d-01 * (gklead3 - gkwash)) -
     +  (-1.000000014901200d-01))) + log(1d0 + exp(-240d0 *
     +  abs((1.000000014901200d-01 * (gklead3 - gkwash)) -
     +  (-1.000000014901200d-01)))) / 240d0) - (max(0d0,
     +  ((1.000000014901200d-01 * (gklead3 - gkwash)) -
     +  (1.000000014901200d-01))) + log(1d0 + exp(-240d0 *
     +  abs((1.000000014901200d-01 * (gklead3 - gkwash)) -
     +  (1.000000014901200d-01)))) / 240d0))
      gkvf = 9.000000357627901d-02 * gkef / 1.460000038147000d+00 -
     +  gkfx
      gkrraw = (-gkreg + 5.000000000000000d+01 * (9.975511002715730d-01
     +  - gkvts + gkvs - gkvf)) / 3.999999910593000d-02
      gkgap = gkef - (2.398297042469149d+00)
      $Power = gkpm
      $Torque = (gkpm - 9.090909227272700d-01 + gktorquestart) /
     +  max(0.1d0, gksp)
      $Field = gkef
      $NativeField = gkef - 2.040749819303170d+00 + gkfieldstart
      IF (.NOT. TIMEZERO) THEN
      STORF(NSTORF + 0) = gkfieldstart + DELT * (10d0 * gksample *
     +  $InitF)
      STORF(NSTORF + 1) = gktorquestart + DELT * (10d0 * gktsample *
     +  $InitT)
      STORF(NSTORF + 2) = gkvalve + DELT * (gkenable * gkvalverate)
      STORF(NSTORF + 3) = gkpt + DELT * (gkenable * (gkvalve - gkpt +
     +  2.500000000000000d+00 * gkvalverate) / 7.500000000000000d+00)
      STORF(NSTORF + 4) = gkx1 + DELT * (gkenable * (gksp - gkx1) /
     +  5.999999865889500d-02)
      STORF(NSTORF + 5) = gkx3 + DELT * (gkenable * (gklead1 - gkx3) /
     +  5.000000000000000d-01)
      STORF(NSTORF + 6) = gkwash + DELT * (gkenable * (gklead3 -
     +  gkwash) / 8.999999761581400d-01)
      STORF(NSTORF + 7) = gkvts + DELT * (gkenable * ($Vterm /
     +  1.380000000000000d+05 - gkvts) / 1.000000000000000d-03)
      STORF(NSTORF + 8) = gkreg + DELT * (gkenable * ((0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkreg - (-1.000000000000000d+00)))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * ((1.000000000000000d+00) - gkreg))) + (1d0 -
     +  (0.5d0 + 0.5d0 * tanh(120d0 * ((1.000000000000000d+00) -
     +  gkreg)))) * (0.5d0 + 0.5d0 * tanh(120d0 * (-gkrraw))) + (1d0 -
     +  (0.5d0 + 0.5d0 * tanh(120d0 * (gkreg -
     +  (-1.000000000000000d+00))))) * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (gkrraw)))) * gkrraw)
      STORF(NSTORF + 9) = gkef + DELT * (gkenable * (gkreg -
     +  6.940776345086145d-01 * gkgap**2 * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (gkgap))) - (-5.999999865889500d-02) * gkef) /
     +  6.000000238418600d-01)
      STORF(NSTORF + 10) = gkfx + DELT * (gkenable * gkvf /
     +  1.460000038147000d+00)
      ENDIF
      NSTORF = NSTORF + 11</segment></script><graphics>
