  <Definition classid="UserCmpDefn" name="Control2_3" group="" build="" id="100006038" view="false" instance="0" crc="0">
   <paramlist>
    <param name="Description" value="2_3_tgov1 / 2_3_ieeet1" />
   </paramlist>
   <form name="2_3_tgov1 / 2_3_ieeet1" w="400" h="400" splitter="60" />
   <script><segment name="Dsdyn" id="1800000018" classid="CoreSegment">#STORAGE REAL:8
#LOCAL REAL gkfieldstart
#LOCAL REAL gktorquestart
#LOCAL REAL gkvalve
#LOCAL REAL gkpt
#LOCAL REAL gkvts
#LOCAL REAL gkreg
#LOCAL REAL gkef
#LOCAL REAL gkfx
#LOCAL REAL gksample
#LOCAL REAL gktsample
#LOCAL REAL gkenable
#LOCAL REAL gksp
#LOCAL REAL gkdw
#LOCAL REAL gkvraw
#LOCAL REAL gkvalverate
#LOCAL REAL gkpm
#LOCAL REAL gkvf
#LOCAL REAL gkrraw
#LOCAL REAL gkgap
      IF (TIMEZERO) THEN
      STORF(NSTORF + 0) = 0.000000000000000d+00
      STORF(NSTORF + 1) = 0.000000000000000d+00
      STORF(NSTORF + 2) = 8.928571723481200d-01
      STORF(NSTORF + 3) = 8.928571723481200d-01
      STORF(NSTORF + 4) = 9.912250100000000d-01
      STORF(NSTORF + 5) = 2.227218893782390d+00
      STORF(NSTORF + 6) = 2.227218893782390d+00
      STORF(NSTORF + 7) = 1.670414170336820d-01
      ENDIF
      gkfieldstart = STORF(NSTORF + 0)
      gktorquestart = STORF(NSTORF + 1)
      gkvalve = STORF(NSTORF + 2)
      gkpt = STORF(NSTORF + 3)
      gkvts = STORF(NSTORF + 4)
      gkreg = STORF(NSTORF + 5)
      gkef = STORF(NSTORF + 6)
      gkfx = STORF(NSTORF + 7)
      gksample = merge(1d0, 0d0, TIME .GT. 0.47d0 .AND. TIME .LE.
     +  0.57d0)
      gktsample = merge(1d0, 0d0, TIME .GT. 0.88d0 .AND. TIME .LE.
     +  0.98d0)
      gkenable = merge(1d0, 0d0, TIME .GE. 1.0d0)
      gksp = merge($Speed, 1d0, TIME .GE. 1.0d0)
      gkdw = gksp - 1d0
      gkvraw = -gkvalve + (4.464285928263700d-02 - gkdw) /
     +  5.000000074505800d-02
      gkvalverate = (((0.5d0 + 0.5d0 * tanh(120d0 * (gkvalve -
     +  (0.000000000000000d+00)))) * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  ((1.000000000000000d+00) - gkvalve))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * ((1.000000000000000d+00) - gkvalve)))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * (-gkvraw))) + (1d0 - (0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkvalve - (0.000000000000000d+00))))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * (gkvraw)))) * gkvraw) /
     +  5.000000000000000d-01
      gkpm = (gkpt - 0.000000000000000d+00 * gkdw) *
     +  1.000000000000000d+00
      gkvf = 9.000000357627901d-02 * gkef / 1.200000047683700d+00 -
     +  gkfx
      gkrraw = (-gkreg + 2.479000091552700d+01 * (1.081068447334740d+00
     +  - gkvts + 0d0 - gkvf)) / 1.999999955296500d-02
      gkgap = gkef - (2.398297042469149d+00)
      $Power = gkpm
      $Torque = (gkpm - 8.928571723481200d-01 + gktorquestart) /
     +  max(0.1d0, gksp)
      $Field = gkef
      $NativeField = gkef - 2.227218893782390d+00 + gkfieldstart
      IF (.NOT. TIMEZERO) THEN
      STORF(NSTORF + 0) = gkfieldstart + DELT * (10d0 * gksample *
     +  $InitF)
      STORF(NSTORF + 1) = gktorquestart + DELT * (10d0 * gktsample *
     +  $InitT)
      STORF(NSTORF + 2) = gkvalve + DELT * (gkenable * gkvalverate)
      STORF(NSTORF + 3) = gkpt + DELT * (gkenable * (gkvalve - gkpt +
     +  2.500000000000000d+00 * gkvalverate) / 7.500000000000000d+00)
      STORF(NSTORF + 4) = gkvts + DELT * (gkenable * ($Vterm /
     +  6.900000000000000d+04 - gkvts) / 1.000000000000000d-03)
      STORF(NSTORF + 5) = gkreg + DELT * (gkenable * ((0.5d0 + 0.5d0 *
     +  tanh(120d0 * (gkreg - (-1.000000000000000d+02)))) * (0.5d0 +
     +  0.5d0 * tanh(120d0 * ((1.000000000000000d+02) - gkreg))) + (1d0 -
     +  (0.5d0 + 0.5d0 * tanh(120d0 * ((1.000000000000000d+02) -
     +  gkreg)))) * (0.5d0 + 0.5d0 * tanh(120d0 * (-gkrraw))) + (1d0 -
     +  (0.5d0 + 0.5d0 * tanh(120d0 * (gkreg -
     +  (-1.000000000000000d+02))))) * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (gkrraw)))) * gkrraw)
      STORF(NSTORF + 6) = gkef + DELT * (gkenable * (gkreg -
     +  6.940776345086145d-01 * gkgap**2 * (0.5d0 + 0.5d0 * tanh(120d0 *
     +  (gkgap))) - (1.000000000000000d+00) * gkef) /
     +  7.200000286102300d-01)
      STORF(NSTORF + 7) = gkfx + DELT * (gkenable * gkvf /
     +  1.200000047683700d+00)
      ENDIF
      NSTORF = NSTORF + 8</segment></script><graphics>
