     +  gkfx
      gkrraw = (-gkreg + 2.903000068664600d+01 * (1.069313489440230d+00
     +  - gkvts + 0d0 - gkvf)) / 5.000000074505800d-02
      gkgap = gkef - (2.398297042469149d+00)
      $Power = gkpm
      $Torque = (gkpm - 7.085714485714300d-01 + gktorquestart) /
     +  max(0.1d0, gksp)
      $Field = gkef
      $NativeField = gkef - 2.111673876397300d+00 + gkfieldstart
      IF (.NOT. TIMEZERO) THEN
