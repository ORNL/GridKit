     +  gkfx
      gkrraw = (-gkreg + 5.000000000000000d+01 * (9.981974821012640d-01
     +  - gkvts + 0d0 - gkvf)) / 3.999999910593000d-02
      gkgap = gkef - (2.398297042469149d+00)
      $Power = gkpm
      $Torque = (gkpm - 6.531522059324900d-01 + gktorquestart) /
     +  max(0.1d0, gksp)
      $Field = gkef
      $NativeField = gkef - 1.502098282520710d+00 + gkfieldstart
      IF (.NOT. TIMEZERO) THEN
