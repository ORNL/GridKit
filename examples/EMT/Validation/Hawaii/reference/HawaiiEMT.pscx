   <form name="Analog PMU, REPCA, REECB and REGCA" w="400" h="400" splitter="60" />
   <script><segment name="Dsdyn" id="1800000003" classid="CoreSegment">#STORAGE REAL:14
#LOCAL REAL gktheta
#LOCAL REAL gkpllxi
#LOCAL REAL gkms
#LOCAL REAL gkip
#LOCAL REAL gkiq
#LOCAL REAL gkil
#LOCAL REAL gkpmup
#LOCAL REAL gkpmuq
#LOCAL REAL gkrepv
#LOCAL REAL gkxq
#LOCAL REAL gkql
#LOCAL REAL gkreev
#LOCAL REAL gkqv
#LOCAL REAL gkpord
#LOCAL REAL gka
#LOCAL REAL gkb
