{
  "$schema": "https://gridkit.readthedocs.io/en/schema/line.schema.json",
  "line": "1.0",
  "name": "500 kV double-circuit vertical lattice",
  "description": "Three arm levels per side, twin bundle at 0.457 m, two shield wires at the peak. Conductor and tower types come from an included catalog.",
  "source": "synthetic example; conductor and earth data illustrative",

  "include": ["north-american.catalog.yaml"],

  "tower": "500kv-double-circuit",

  "conductors": [
    { "at": "left-lower-1",  "phase": "a", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "left-lower-2",  "phase": "a", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "left-mid-1",    "phase": "b", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "left-mid-2",    "phase": "b", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "left-upper-1",  "phase": "c", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "left-upper-2",  "phase": "c", "circuit": 1, "type": "cardinal-acsr" },
    { "at": "right-lower-1", "phase": "a", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "right-lower-2", "phase": "a", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "right-mid-1",   "phase": "b", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "right-mid-2",   "phase": "b", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "right-upper-1", "phase": "c", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "right-upper-2", "phase": "c", "circuit": 2, "type": "cardinal-acsr" },
    { "at": "shield-left",   "phase": "g", "type": "ehs-3-8-steel" },
    { "at": "shield-right",  "phase": "g", "type": "ehs-3-8-steel" }
  ],

  "path": {
    "span": 400.0,
    "length": 250000.0
  },

  "earth": {
    "conductivity": 0.01
  }
}
