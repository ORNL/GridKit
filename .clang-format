---
Language:        Cpp
BasedOnStyle:  LLVM

IndentWidth: 4                   # 4 spaces per indent
IndentAccessModifiers: false     # Align access modifiers to braces
BreakBeforeBraces: Allman        # Braces on their own lines
SpaceBeforeParens: SBPO_ControlStatementsExceptControlMacros
SpaceAfterCStyleCast: true
SeparateDefinitionBlocks: Always # Separate definitions (functions etc.) with an empty line
IncludeBlocks: Merge             # Regroup includes based on config
IncludeCategories:
  - Regex:           '^"'        # 'local' includes
    Priority:        2
    SortPriority:    0
    CaseSensitive:   false
  - Regex:           '/'         # Library includes
    Priority:        3
    SortPriority:    0
    CaseSensitive:   false
  - Regex:           '.*'        # Everything else
    Priority:        1
    SortPriority:    0
    CaseSensitive:   false
...

