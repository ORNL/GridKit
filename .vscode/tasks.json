{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Containers: Build gridkit-dev:latest",
			"type": "process",
			"command": "/usr/bin/podman",
			"args": [
				"build",
				"--tag",
				"gridkit-dev:latest",
				".devcontainer"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Containers: Build gridkit:<tag>",
			"type": "process",
			"command": "/usr/bin/podman",
			"args": [
				"build",
				"--build-arg",
				"BUILDER_IMAGE=gridkit-dev:latest",
				"--file",
				"docker/Dockerfile",
				"--tag",
				"gridkit:${input:tag}",
				"."
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Containers: Publish gridkit:<tag> to personal GHCR",
			"type": "process",
			"command": "/usr/bin/bash",
			"args": [
				"-c",
				"read -r -p \"Publish gridkit:$0 to ghcr.io/lukelowry/gridkit:$0? Type PUBLISH to continue: \" answer\nif [[ \"$answer\" != \"PUBLISH\" ]]; then\n  echo 'Publish cancelled.'\n  exit 0\nfi\nexec /usr/bin/podman push \"gridkit:$0\" \"docker://ghcr.io/lukelowry/gridkit:$0\"",
				"${input:tag}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"focus": true
			}
		}
	],
	"inputs": [
		{
			"id": "tag",
			"type": "promptString",
			"description": "Image tag, e.g. latest or arrow-2026-09-09",
			"default": "latest"
		}
	]
}
